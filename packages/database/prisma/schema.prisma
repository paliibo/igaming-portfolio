generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity & access ----------

enum Role {
  PLAYER
  OPERATOR
  ADMIN
}

enum PlayerStatus {
  ACTIVE
  SUSPENDED
  COOLING_OFF
  SELF_EXCLUDED
  CLOSED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       PlayerProfile?
  wallet        Wallet?
  bets          Bet[]
  gameSessions  GameSession[]
  gameRounds    GameRound[]
  favorites     FavoriteGame[]
  limits        PlayerLimit[]
  riskAlerts    RiskAlert[]
  adminNotes    AdminNote[]      @relation("NoteTarget")
  authoredNotes AdminNote[]      @relation("NoteAuthor")
  auditActions  AuditLog[]       @relation("AuditActor")
  journalEntries JournalEntry[]
  idempotencyRecords IdempotencyRecord[]
  resolvedAlerts RiskAlert[]     @relation("AlertResolver")

  @@index([role])
}

model PlayerProfile {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             PlayerStatus @default(ACTIVE)
  kycStatus          KycStatus    @default(PENDING)
  country            String       @default("DEMO")
  selfExcludedUntil  DateTime?
  coolingOffUntil    DateTime?
  suspendedReason    String?
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
  @@index([kycStatus])
}

enum LimitType {
  DAILY_TOPUP
  DAILY_WAGER
  DAILY_LOSS
}

model PlayerLimit {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LimitType
  amountMinor BigInt
  setById     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, type])
}

// ---------- Wallet & double-entry ledger ----------

enum LedgerAccountKind {
  PLAYER_WALLET
  HOUSE_FLOAT
  SPORTSBOOK_REVENUE
  CASINO_REVENUE
  ADJUSTMENTS
}

model LedgerAccount {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  kind      LedgerAccountKind
  currency  String            @default("DMO")
  createdAt DateTime          @default(now())

  wallet Wallet?
  lines  JournalLine[]
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String   @unique
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  currency     String   @default("DMO")
  balanceMinor BigInt   @default(0)
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
}

enum JournalEntryKind {
  TOPUP
  BET_STAKE
  BET_PAYOUT
  BET_REFUND
  CASINO_STAKE
  CASINO_PAYOUT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  REVERSAL
  TRANSFER
}

enum LineDirection {
  DEBIT
  CREDIT
}

model JournalEntry {
  id             String           @id @default(uuid())
  kind           JournalEntryKind
  description    String
  referenceType  String?
  referenceId    String?
  idempotencyKey String?          @unique
  metadata       Json?
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id])
  reversalOfId   String?          @unique
  reversalOf     JournalEntry?    @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry?    @relation("Reversal")
  createdAt      DateTime         @default(now())

  lines        JournalLine[]
  transactions WalletTransaction[]

  @@index([kind, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model JournalLine {
  id          String        @id @default(uuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  direction   LineDirection
  amountMinor BigInt

  @@index([entryId])
  @@index([accountId])
}

/// Player-facing view of a wallet movement; one row per wallet per journal entry.
model WalletTransaction {
  id                String           @id @default(uuid())
  walletId          String
  wallet            Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  entryId           String
  entry             JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind              JournalEntryKind
  amountMinor       BigInt
  balanceAfterMinor BigInt
  referenceType     String?
  referenceId       String?
  description       String
  createdAt         DateTime         @default(now())

  @@unique([walletId, entryId])
  @@index([walletId, createdAt])
  @@index([kind])
  @@index([referenceType, referenceId])
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  scope        String
  key          String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestHash  String
  responseBody Json
  statusCode   Int
  createdAt    DateTime @default(now())

  @@unique([scope, key])
  @@index([createdAt])
}

// ---------- Sportsbook ----------

enum SportsEventStatus {
  SCHEDULED
  LIVE
  FINISHED
  SETTLED
  CANCELLED
}

enum MarketStatus {
  OPEN
  SUSPENDED
  CLOSED
  SETTLED
}

enum MarketType {
  MATCH_WINNER
  TOTAL
  BOTH_TEAMS_TO_SCORE
  HANDICAP
}

enum SelectionResult {
  WON
  LOST
  VOID
}

enum BetStatus {
  OPEN
  WON
  LOST
  VOID
  CANCELLED
}

model Sport {
  id     String        @id @default(uuid())
  slug   String        @unique
  name   String
  events SportsEvent[]
}

model SportsEvent {
  id          String            @id @default(uuid())
  sportId     String
  sport       Sport             @relation(fields: [sportId], references: [id])
  competition String
  homeTeam    String
  awayTeam    String
  startsAt    DateTime
  status      SportsEventStatus @default(SCHEDULED)
  homeScore   Int               @default(0)
  awayScore   Int               @default(0)
  clockMinute Int               @default(0)
  periodLabel String?
  featured    Boolean           @default(false)
  settledAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  markets BettingMarket[]

  @@index([status, startsAt])
  @@index([sportId])
}

model BettingMarket {
  id        String       @id @default(uuid())
  eventId   String
  event     SportsEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      MarketType
  name      String
  line      Decimal?     @db.Decimal(6, 2)
  status    MarketStatus @default(OPEN)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  selections MarketSelection[]

  @@index([eventId])
}

/// priceMilli is a decimal price in thousandths: 2500 = 2.500.
model MarketSelection {
  id             String           @id @default(uuid())
  marketId       String
  market         BettingMarket    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  name           String
  outcomeKey     String
  priceMilli     Int
  priceUpdatedAt DateTime         @default(now())
  priceVersion   Int              @default(0)
  result         SelectionResult?
  sortOrder      Int              @default(0)

  betSelections BetSelection[]

  @@unique([marketId, outcomeKey])
}

model Bet {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  idempotencyKey       String
  stakeMinor           BigInt
  totalPriceMilli      BigInt
  potentialPayoutMinor BigInt
  payoutMinor          BigInt?
  status               BetStatus @default(OPEN)
  stakeEntryId         String?
  settlementEntryId    String?
  placedAt             DateTime  @default(now())
  settledAt            DateTime?

  selections BetSelection[]

  @@unique([userId, idempotencyKey])
  @@index([userId, placedAt])
  @@index([status])
}

model BetSelection {
  id           String           @id @default(uuid())
  betId        String
  bet          Bet              @relation(fields: [betId], references: [id], onDelete: Cascade)
  selectionId  String
  selection    MarketSelection  @relation(fields: [selectionId], references: [id])
  priceMilli   Int
  result       SelectionResult?

  @@index([selectionId])
  @@index([betId])
}

// ---------- Casino ----------

enum GameCategory {
  SLOTS
  DICE
  TABLE
  INSTANT
}

enum GameStatus {
  ACTIVE
  DISABLED
  MAINTENANCE
}

enum GameSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum GameRoundStatus {
  COMPLETED
  FAILED
}

model CasinoGame {
  id            String       @id @default(uuid())
  slug          String       @unique
  name          String
  providerKey   String
  providerGameId String
  category      GameCategory
  status        GameStatus   @default(ACTIVE)
  description   String
  volatility    String
  theoreticalRtpLabel String
  minStakeMinor BigInt
  maxStakeMinor BigInt
  maxWinMultiplier Int
  featured      Boolean      @default(false)
  playable      Boolean      @default(false)
  artwork       Json
  tags          String[]
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions  GameSession[]
  rounds    GameRound[]
  favorites FavoriteGame[]

  @@index([category, status])
}

model FavoriteGame {
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      CasinoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([userId, gameId])
}

model GameSession {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  gameId      String
  game        CasinoGame        @relation(fields: [gameId], references: [id])
  providerKey String
  providerSessionRef String
  status      GameSessionStatus @default(ACTIVE)
  startedAt   DateTime          @default(now())
  lastActivityAt DateTime       @default(now())
  endedAt     DateTime?

  rounds GameRound[]

  @@index([userId, status])
}

model GameRound {
  id              String          @id @default(uuid())
  roundNumber     BigInt          @default(autoincrement())
  clientRoundKey  String
  sessionId       String
  session         GameSession     @relation(fields: [sessionId], references: [id])
  gameId          String
  game            CasinoGame      @relation(fields: [gameId], references: [id])
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  providerRoundRef String
  stakeMinor      BigInt
  payoutMinor     BigInt
  status          GameRoundStatus
  input           Json
  outcome         Json
  stakeEntryId    String?
  payoutEntryId   String?
  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  @@unique([userId, clientRoundKey])
  @@index([userId, createdAt])
  @@index([gameId, createdAt])
}

// ---------- Risk, audit, operations ----------

enum RiskAlertType {
  LARGE_STAKE
  RAPID_PLAY
  LIMIT_BREACH_ATTEMPT
  DAILY_LOSS
  MANUAL
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum RiskAlertStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model RiskAlert {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       RiskAlertType
  severity   RiskSeverity
  status     RiskAlertStatus @default(OPEN)
  message    String
  metadata   Json?
  resolvedById String?
  resolvedBy User?           @relation("AlertResolver", fields: [resolvedById], references: [id])
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

model AdminNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("NoteTarget", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorEmail String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
}
