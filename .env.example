# Copy to .env — the API, the Prisma CLI and the Playwright suite all read this file.
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://igaming:igaming@localhost:5440/igaming
TEST_DATABASE_URL=postgresql://igaming:igaming@localhost:5440/igaming_test
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-in-production-at-least-32-chars-long
SESSION_COOKIE_NAME=igaming_session
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Demo accounts created by the seed. Change before deploying anywhere public.
DEMO_PLAYER_EMAIL=player@demo.local
DEMO_PLAYER_PASSWORD=Player123!
DEMO_OPERATOR_EMAIL=operator@demo.local
DEMO_OPERATOR_PASSWORD=Operator123!
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=Admin123!
# Development-only: enables POST /api/admin/demo/reset. Ignored when NODE_ENV=production.
DEMO_RESET_ENABLED=true
# Background simulation toggles (odds drift, match clock, auto settlement).
SIMULATOR_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:4000
